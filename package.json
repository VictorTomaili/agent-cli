{
  "name": "@victortomaili/agent-cli",
  "version": "0.7.0",
  "description": "Manage AGENTS.md and sync it across all your AI coding agents (Claude Code, Codex, Gemini, Cursor, Windsurf, Cline, Copilot, DeepSeek Harness, and more). One canonical source in ~/.agents/, mirrored everywhere.",
  "license": "MIT",
  "author": "Victor Tomaili <victor@tomaili.com>",
  "homepage": "https://github.com/VictorTomaili/agent-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VictorTomaili/agent-cli.git"
  },
  "bugs": {
    "url": "https://github.com/VictorTomaili/agent-cli/issues"
  },
  "type": "module",
  "bin": {
    "agent-cli": "./src/cli.js"
  },
  "main": "./src/cli.js",
  "exports": {
    ".": "./src/cli.js",
    "./targets": "./src/targets.js",
    "./api": "./src/api/index.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "cli": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:verbose": "node --test test/*.test.js --test-reporter spec",
    "check": "node -e \"const fs=require('fs'),cp=require('child_process'),p=require('path');function w(d){return fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?w(p.join(d,e.name)):[p.join(d,e.name)])}for(const f of w('src').filter(f=>f.endsWith('.js')))cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "build": "npm run check",
    "lint": "npm run check",
    "agent-cli": "node src/cli.js"
  },
  "keywords": [
    "agents",
    "agents.md",
    "ai-coding-agent",
    "claude",
    "claude-code",
    "cli",
    "cline",
    "codex",
    "copilot",
    "cursor",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "gemini",
    "sync",
    "windsurf"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "src",
    "seed",
    "README.md",
    "LICENSE",
    "docs/contract.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@inquirer/core": "^12.0.0",
    "@inquirer/prompts": "^7.10.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  }
}
