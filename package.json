{"name":"@tomaili/agent","version":"0.2.1","description":"Manage AGENTS.md and sync it across all your AI coding agents (Claude Code, Codex, Gemini, Cursor, Windsurf, Cline, Copilot, and more). One canonical source in ~/.agents/, mirrored everywhere.","license":"MIT","author":"Victor Tomaili <victor@tomaili.com>","homepage":"https://github.com/tomaili/agent#readme","repository":{"type":"git","url":"git+https://github.com/tomaili/agent.git"},"bugs":{"url":"https://github.com/tomaili/agent/issues"},"type":"module","bin":{"agent":"./src/cli.js"},"main":"./src/cli.js","exports":{".":"./src/cli.js","./targets":"./src/targets.js"},"scripts":{"start":"node src/cli.js","cli":"node src/cli.js","agent":"node src/cli.js","test":"node --test test/*.test.js","test:verbose":"node --test test/*.test.js --test-reporter spec","check":"node -e \"const fs=require('fs'),cp=require('child_process'),p=require('path');function w(d){return fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?w(p.join(d,e.name)):[p.join(d,e.name)])}for(const f of w('src').filter(f=>f.endsWith('.js')))cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"","build":"npm run check","lint":"npm run check"},"keywords":["agents","agents.md","claude","claude-code","codex","gemini","cursor","windsurf","cline","copilot","sync","cli","ai-coding-agent"],"engines":{"node":">=18.0.0"},"files":["src","seed","README.md","LICENSE"],"publishConfig":{"access":"public","registry":"https://registry.npmjs.org/"},"dependencies":{"@inquirer/core":"^10.3.2","@inquirer/prompts":"^7.10.1","commander":"^12.1.0","picocolors":"^1.1.1","yaml":"^2.9.0"}}